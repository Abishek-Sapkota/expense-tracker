    {"id": "design_add_expense_dialog_screen_date_field", "label": "Date Field with Today Default", "file_type": "image", "source_file": "/home/abi/stuff/expense_tracker/design/add_expense_dialog/screen.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "design_add_expense_dialog_screen_paid_via_field", "label": "Paid Via Account Selector (SBI ••4091)", "file_type": "image", "source_file": "/home/abi/stuff/expense_tracker/design/add_expense_dialog/screen.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "design_add_expense_dialog_screen_action_bar", "label": "Cancel / Add Action Bar", "file_type": "image", "source_file": "/home/abi/stuff/expense_tracker/design/add_expense_dialog/screen.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "design_add_expense_dialog_screen_modal_scrim_pattern", "label": "Modal Sheet Over Dimmed Transaction List", "file_type": "rationale", "source_file": "/home/abi/stuff/expense_tracker/design/add_expense_dialog/screen.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The entry form is presented as a rounded modal sheet floating above a scrimmed, still-visible transaction list rather than a full-screen route, so the user keeps spatial context of the ledger they are adding to and can dismiss back to it cheaply; the scrim also enforces that Add/Cancel are the only exits."},
    {"id": "design_add_expense_dialog_screen_smart_defaults", "label": "Smart Defaults for Low-Friction Entry", "file_type": "rationale", "source_file": "/home/abi/stuff/expense_tracker/design/add_expense_dialog/screen.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every field arrives pre-filled or one-tap: date defaults to Today, payment method defaults to the last-used account (SBI ••4091), and categories are offered as recurring habit chips (Chai, Auto, Meal, Grocery). The trade-off accepted is less explicitness per entry in exchange for a sub-5-second logging path, since abandoned entry is the dominant failure mode for expense trackers."},
    {"id": "design_add_expense_dialog_screen_two_column_metadata_row", "label": "Two-Column Metadata Row Layout", "file_type": "concept", "source_file": "/home/abi/stuff/expense_tracker/design/add_expense_dialog/screen.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Date and Paid via are paired side-by-side as equal-weight filled cards with label-above-value typography, compressing secondary metadata into one vertical band so the sheet stays short enough to sit above the keyboard."},
    {"id": "design_add_expense_dialog_screen_material3_language", "label": "Material 3 Expressive Design Language", "file_type": "concept", "source_file": "/home/abi/stuff/expense_tracker/design/add_expense_dialog/screen.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "design_add_expense_dialog_screen_india_upi_context", "label": "India / UPI Localization Context", "file_type": "concept", "source_file": "/home/abi/stuff/expense_tracker/design/add_expense_dialog/screen.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Content is localized to an Indian urban commuter: Namma Metro Smart Card, Chai and Auto categories, and a masked SBI bank account as the funding source, implying account/UPI-style payment-source modelling rather than generic cash/card."},
    {"id": "design_add_expense_dialog_screen_transaction_record", "label": "Transaction Record (amount, note, category, date, account)", "file_type": "concept", "source_file": "/home/abi/stuff/expense_tracker/design/add_expense_dialog/screen.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "design_add_expense_dialog_screen_destructive_confirm_asymmetry", "label": "Weighted Confirm vs Text Cancel", "file_type": "rationale", "source_file": "/home/abi/stuff/expense_tracker/design/add_expense_dialog/screen.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Add is a high-contrast filled pill with a check icon while Cancel is an unbounded text label, deliberately biasing the tap target toward committing the entry; discard stays reachable but visually unattractive."}
  ],
