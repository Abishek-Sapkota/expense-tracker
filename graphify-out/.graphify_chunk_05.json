{
  "nodes": [
    {
      "id": "design_home_dark_screen_ledger_home_screen",
      "label": "Ledger Home Screen (Dark Variant Mock)",
      "file_type": "image",
      "source_file": "/home/abi/stuff/expense_tracker/design/home_dark/screen.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Primary landing screen of an Indian-rupee personal expense tracker named 'Ledger'. Composition is a single vertical scroll: today's money summary first, then a remediation banner, then the transaction feed, with a privacy reassurance footer and a persistent Add-new FAB. Puts the one number a user checks daily (total spent today) above the fold and defers everything else."
    },
    {
      "id": "design_home_dark_screen_todays_summary_card",
      "label": "Today's Summary Card",
      "file_type": "image",
      "source_file": "/home/abi/stuff/expense_tracker/design/home_dark/screen.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Hero card showing a single oversized figure (Rs 1,240.00) labelled 'total spent today'. Typographic scale carries the hierarchy instead of color, so the card still reads at a glance in either theme."
    },
    {
      "id": "design_home_dark_screen_debits_received_split",
      "label": "Debits / Received Dual Metric Tiles",
      "file_type": "image",
      "source_file": "/home/abi/stuff/expense_tracker/design/home_dark/screen.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Two side-by-side tiles inside the summary card: down-arrow Debits in a red/warm tint, up-arrow Received in green. Direction is encoded redundantly by arrow glyph, sign prefix and hue so the meaning survives color-blindness and grayscale."
    },
    {
      "id": "design_home_dark_screen_unlinked_sender_banner",
      "label": "Unlinked Sender Remediation Banner",
      "file_type": "image",
      "source_file": "/home/abi/stuff/expense_tracker/design/home_dark/screen.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Actionable card reading '3 senders not linked to a bank / Assign accounts for clearer audit logs' with a chevron affordance. Surfaces incomplete parser state as a task the user can resolve rather than silently dropping unattributed SMS transactions."
    },
    {
      "id": "design_home_dark_screen_transaction_list",
      "label": "Transactions Feed",
      "file_type": "image",
      "source_file": "/home/abi/stuff/expense_tracker/design/home_dark/screen.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Section header 'Transactions' with a count pill (5) and an Export CSV affordance. Count pill plus explicit export signals the feed is a complete auditable record, not a sampled highlight list."
    },
    {
      "id": "design_home_dark_screen_transaction_row",
      "label": "Transaction Row Pattern",
      "file_type": "image",
      "source_file": "/home/abi/stuff/expense_tracker/design/home_dark/screen.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Uniform four-zone row: category icon avatar, merchant name plus category tag, a provenance subline (bank, date, masked account tail such as ..1234 or 'Added by you / Cash'), and a right column with signed amount over a trust badge. The masked-tail subline lets the user verify which card or account a parsed SMS came from without leaving the list."
    },
    {
      "id": "design_home_dark_screen_parse_status_badge",
      "label": "Parse Trust Badge (Parsed / Verified / Cash / Review)",
      "file_type": "concept",
      "source_file": "/home/abi/stuff/expense_tracker/design/home_dark/screen.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Per-row badge exposing where the record came from and how confident the system is: Parsed (auto-extracted), Verified (matched/confirmed), Cash (hand-entered), Review (low confidence, needs a human). Makes automated extraction auditable per record instead of asking the user to trust the parser wholesale."
    },
    {
      "id": "design_home_dark_screen_category_tag",
      "label": "Category Tag Chip",
      "file_type": "image",
      "source_file": "/home/abi/stuff/expense_tracker/design/home_dark/screen.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Inline chip beside the merchant name (Food, Income, Supplies, Manual). One row shows a redacted/empty chip, implying uncategorized transactions render a placeholder rather than collapsing the layout."
    },
    {
      "id": "design_home_dark_screen_review_queue",
      "label": "Low-Confidence Review Flow",
      "file_type": "rationale",
      "source_file": "/home/abi/stuff/expense_tracker/design/home_dark/screen.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The 'Quick Pharmacy' row pairs 'Unlinked sender' provenance with a question-mark 'Review' badge and a truncated account tail. Uncertain parses are kept in the ledger and flagged rather than hidden, so totals stay complete while the ambiguity remains visible for correction."
    },
    {
      "id": "design_home_dark_screen_account_linking",
      "label": "Sender-to-Account Linking",
      "file_type": "rationale",
      "source_file": "/home/abi/stuff/expense_tracker/design/home_dark/screen.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Mapping SMS sender IDs to user-declared bank accounts (HDFC, ICICI Bank) is what converts raw messages into attributable ledger entries; the banner's own copy states the payoff as 'clearer audit logs'."
    },
    {
      "id": "design_home_dark_screen_sms_parsing",
      "label": "On-Device SMS Transaction Parsing",
      "file_type": "rationale",
      "source_file": "/home/abi/stuff/expense_tracker/design/home_dark/screen.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Core ingestion mechanism: bank SMS alerts are parsed locally into transactions, evidenced by the 'Parsed SMS' nav destination, the 'Parsed' badges and bank-plus-masked-account sublines. Chosen over bank API aggregation because it needs no institutional integration and works offline on the handset."
    },
    {
      "id": "design_home_dark_screen_manual_entry",
      "label": "Manual Cash Entry",
      "file_type": "rationale",
      "source_file": "/home/abi/stuff/expense_tracker/design/home_dark/screen.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The 'Chai Point / Added by you / Cash' row plus the Add-new FAB cover spend that never produces an SMS. Without it the daily total would systematically undercount cash, which is the failure mode of pure SMS-parsing trackers in an India-first context."
    },
    {
      "id": "design_home_dark_screen_add_new_fab",
      "label": "Add New Floating Action Button",
      "file_type": "image",
      "source_file": "/home/abi/stuff/expense_tracker/design/home_dark/screen.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Extended FAB with a plus glyph and text label, bottom-right above the tab bar, in the only saturated brand color on the screen. Single high-contrast accent makes the primary write action unmistakable on an otherwise neutral surface."
    },
    {
      "id": "design_home_dark_screen_export_csv_action",
      "label": "Export CSV Action",
      "file_type": "image",
      "source_file": "/home/abi/stuff/expense_tracker/design/home_dark/screen.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Download-icon text action aligned right on the Transactions header. Gives a local-only app a data-portability escape hatch, which is what makes the no-cloud stance acceptable rather than lock-in."
    },
    {
      "id": "design_home_dark_screen_offline_indicator",
      "label": "Offline / Auto-Synced Status Indicator",
      "file_type": "image",
      "source_file": "/home/abi/stuff/expense_tracker/design/home_dark/screen.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Green 'Offline' pill in the status bar area plus an 'Auto-synced' line under the summary header. Offline is presented as a normal, even reassuring state rather than an error, consistent with the local-first posture."
    },
    {
      "id": "design_home_dark_screen_privacy_notice",
      "label": "Zero Cloud Uploads Notice",
      "file_type": "image",
      "source_file": "/home/abi/stuff/expense_tracker/design/home_dark/screen.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Lock-icon footer card: 'Zero cloud uploads. All transaction records and SMS parsing remain 100% on this handset.' Placed at the end of the feed so the claim is read after the user has seen exactly what data the app holds."
    },
    {
      "id": "design_home_dark_screen_on_device_privacy",
      "label": "Local-First / On-Device-Only Data Principle",
      "file_type": "rationale",
      "source_file": "/home/abi/stuff/expense_tracker/design/home_dark/screen.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Governing architectural stance: SMS bodies and derived transactions never leave the device, so there is no server-side account, no backend parser and no cloud sync. Trades multi-device continuity and server-side ML for a privacy claim strong enough to justify the sensitive SMS-read permission the parser requires."
    },
    {
      "id": "design_home_dark_screen_bottom_nav",
      "label": "Bottom Navigation (Ledger / Trends / Accounts / Parsed SMS)",
      "file_type": "image",
      "source_file": "/home/abi/stuff/expense_tracker/design/home_dark/screen.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Four fixed destinations mirroring the data model: the record (Ledger), the analysis (Trends), the sources (Accounts) and the raw ingestion layer (Parsed SMS). Exposing Parsed SMS as a first-class tab is unusual and reinforces that the parser is inspectable, not a black box."
    },
    {
      "id": "design_home_dark_screen_app_header",
      "label": "App Header (Menu / Ledger Title / Sync / Profile)",
      "file_type": "image",
      "source_file": "/home/abi/stuff/expense_tracker/design/home_dark/screen.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Hamburger at left, serif wordmark 'Ledger', manual re-sync/re-scan glyph and a circular avatar at right. The serif wordmark against an otherwise geometric sans UI is the main brand signal."
    },
    {
      "id": "design_home_dark_screen_dark_theme_variant",
      "label": "Dark Theme Variant (directory-implied)",
      "file_type": "image",
      "source_file": "/home/abi/stuff/expense_tracker/design/home_dark/screen.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The containing directory is named home_dark, implying this is the dark-mode counterpart of a home screen, but the rendered mock is a light cream-and-clay palette with dark text. Either the mock is mislabelled, the export rendered the light theme, or 'dark' names a warm low-glare variant rather than a true dark surface. Flagged as uncertain."
    }
  ],
